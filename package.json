{
  "name": "project-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "lint-staged",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "flag:new": "node scripts/create-feature-flag.mjs",
    "flag:remove": "node scripts/remove-feature-flag.mjs",
    "registry:run": "node scripts/with-gitlab-registry-auth.mjs",
    "prepare": "husky",
    "release": "release-it --git.tagExclude='*[-]*'",
    "staging-release": "release-it --preRelease=rc --no-github.release"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,jsonc,css,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mono/auth": "^0.2.0",
    "@mono/hooks": "^0.2.0",
    "@mono/ui": "^0.2.1",
    "@mono/utils": "^0.2.0",
    "@tanstack/react-query": "^5.90.19",
    "lucide-react": "^0.562.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.71.1",
    "sonner": "^2.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@release-it/conventional-changelog": "8.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.10",
    "release-it": "17.3.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.12"
  }
}
